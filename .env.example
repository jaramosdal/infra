# --- CONFIGURACIÓN DE POSTGRES ---
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=infra

# --- CONFIGURACIÓN DE N8N ---
# Estos deben coincidir con los de arriba para que n8n se conecte
N8N_DB_TYPE=postgresdb
N8N_DB_HOST=postgres
N8N_DB_PORT=5432
N8N_ENCRYPTION_KEY=churro # resultado del comando: openssl rand -hex 32

# --- CONFIGURACIÓN DE RABBITMQ ---
RABBIT_USER=admin_javi
RABBIT_PASSWORD=password_ultra_seguro
RABBIT_NODENAME=rabbit@rabbitmq_dev

# --- CONFIGURACIÓN DE MOLTBOT ---
DISCORD_WEBHOOK_URL_FACTURAS=https://discordapp.com/api/webhooks/xxx/yyy

# --- CONFIGURACIÓN DE GLITCHTIP ---
GLITCHTIP_SECRET_KEY=cambia-esto-a-un-valor-aleatorio-largo
GLITCHTIP_DOMAIN=http://localhost:8000
# El DSN se obtiene desde la UI de GlitchTip tras crear un proyecto
GLITCHTIP_DSN=http://clave@localhost:8000/1

# --- AZURE ---
AZURE_TENANT_ID=guid-del-tenant
AZURE_CLIENT_ID=guid-del-client-id
AZURE_CLIENT_SECRET=valor-secreto-del-client-secret

# --- AZURE APPLICATION INSIGHTS ---
AZURE_APP_ID=guid-del-app-id
